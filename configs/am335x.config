# ==========================================
# 1. 目标平台：TI AM335x (OMAP)
# ==========================================
CONFIG_TARGET_omap=y
CONFIG_TARGET_omap_generic=y
CONFIG_TARGET_omap_generic_DEVICE_ti_am335x-c3000a=y

# ==========================================
# 2. 内核底层核心驱动锁定 (免交互替代 kernel_menuconfig)
# ==========================================
# PMIC 电源管理芯片 TPS65910 (核心供电、调频与 SD 卡 vmmc 供电)
CONFIG_KERNEL_MFD_TPS65910=y
CONFIG_KERNEL_REGULATOR_TPS65910=y
CONFIG_KERNEL_RTC_DRV_TPS65910=y

# 片内硬件看门狗 (procd 自动接管喂狗，防止意外重启)
CONFIG_KERNEL_WATCHDOG=y
CONFIG_KERNEL_OMAP_WATCHDOG=y

# DMA 引擎与 USB MUSB 控制器 (确保高速 USB 正常工作)
CONFIG_KERNEL_DMADEVICES=y
CONFIG_KERNEL_TI_EDMA=y
CONFIG_KERNEL_TI_CPPI41=y
CONFIG_KERNEL_USB_MUSB_HDRC=y
CONFIG_KERNEL_USB_MUSB_DSPS=y
CONFIG_KERNEL_USB_TI_CPPI41_DMA=y

# 双千兆网卡与 MDIO 总线驱动
CONFIG_KERNEL_TI_CPSW=y
CONFIG_KERNEL_TI_DAVINCI_MDIO=y

# TI 串口蓝牙底层协议 (Serdev + HCI_LL)
CONFIG_KERNEL_SERIAL_DEV_BUS=y
CONFIG_KERNEL_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_KERNEL_BT_HCIUART=y
CONFIG_KERNEL_BT_HCIUART_LL=y

# 外部 RTC 时钟 RX8025、I2C GPIO 扩展 PCA9535 及板载 LED
CONFIG_KERNEL_RTC_DRV_RX8025=y
CONFIG_KERNEL_GPIO_PCA953X=y
CONFIG_KERNEL_GPIO_PCA953X_IRQ=y
CONFIG_KERNEL_LEDS_GPIO=y

# 板载声卡驱动 (TI McASP + TLV320AIC3106 + Simple Card)
CONFIG_KERNEL_SOUND=y
CONFIG_KERNEL_SND=y
CONFIG_KERNEL_SND_SOC=y
CONFIG_KERNEL_SND_DAVINCI_SOC=y
CONFIG_KERNEL_SND_DAVINCI_SOC_MCASP=y
CONFIG_KERNEL_SND_SOC_TLV320AIC3X=y
CONFIG_KERNEL_SND_SOC_TLV320AIC3X_I2C=y
CONFIG_KERNEL_SND_SIMPLE_CARD=y

# 1GB NAND Flash 与硬件 ELM BCH8 纠错驱动
CONFIG_KERNEL_MTD_NAND_OMAP2=y
CONFIG_KERNEL_MTD_NAND_OMAP_BCH=y

# 硬件加密引擎 (AES/SHA) 与真随机数生成器 (RNG)
CONFIG_KERNEL_CRYPTO_HW=y
CONFIG_KERNEL_CRYPTO_DEV_OMAP=y
CONFIG_KERNEL_CRYPTO_DEV_OMAP_AES=y
CONFIG_KERNEL_CRYPTO_DEV_OMAP_SHAM=y
CONFIG_KERNEL_HW_RANDOM=y
CONFIG_KERNEL_HW_RANDOM_OMAP=y

# ==========================================
# 3. OpenWrt 基础系统、LuCI 网页管理与物理按键
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_libgpiod-tools=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ubi-utils=y

# ==========================================
# 4. SD 卡与文件系统支持 (EXT4 + FAT32)
# ==========================================
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y

# ==========================================
# 5. USB 主机与常见串口芯片支持 (外接 USB GPS / 4G 模块)
# ==========================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-musb=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
# ==========================================
# 6. 双千兆网卡 PHY 驱动与网络工具
# ==========================================
CONFIG_PACKAGE_kmod-phy-broadcom=y
CONFIG_PACKAGE_kmod-phy-marvell=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-phy-atheros=y
CONFIG_KERNEL_AT803X_PHY=y
CONFIG_KERNEL_TI_CPSW_SWITCHDEV=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
# ==========================================
# 7. 板载蓝牙 (A2DP 音箱) 与板载音频播放器支持
# ==========================================
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-alsa=y
CONFIG_PACKAGE_alsa-utils=y
CONFIG_PACKAGE_mpg123=y

# ==========================================
# 8. GPS 定位服务与串口调试工具
# ==========================================
CONFIG_PACKAGE_gpsd=y
CONFIG_PACKAGE_gpsd-clients=y
CONFIG_PACKAGE_picocom=y

# ==========================================
# 9. 硬件加密引擎 (AES/SHA/RNG) 与 OpenSSL 硬件加速
# ==========================================
CONFIG_PACKAGE_kmod-crypto-hw-omap=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_openssl-util=y

# ==========================================
# 10. 双路工业 CAN 总线支持
# ==========================================
CONFIG_PACKAGE_kmod-can=y
CONFIG_PACKAGE_kmod-can-c-can=y
CONFIG_PACKAGE_kmod-can-c-can-platform=y
CONFIG_PACKAGE_canutils=y


# LCD 显示控制器与 PWM 背光驱动
CONFIG_KERNEL_DRM=y
CONFIG_KERNEL_DRM_TILCDC=y
CONFIG_KERNEL_PWM=y
CONFIG_KERNEL_PWM_TIECAP=y
CONFIG_KERNEL_BACKLIGHT_CLASS_DEVICE=y
CONFIG_KERNEL_BACKLIGHT_PWM=y

# 蜂鸣器与输入事件驱动
CONFIG_KERNEL_INPUT_MISC=y
CONFIG_KERNEL_INPUT_GPIO_BEEPER=y

# 强制内置 TI OMAP 原生 8250 串口驱动（修复波特率时钟分频乱码与 ttyS0 顺序）
CONFIG_KERNEL_SERIAL_8250=y
CONFIG_KERNEL_SERIAL_8250_CONSOLE=y
CONFIG_KERNEL_SERIAL_8250_OMAP=y
CONFIG_KERNEL_SERIAL_8250_OMAP_TTYO_FIXUP=y
CONFIG_KERNEL_SERIAL_OF_PLATFORM=y



CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_vsftpd=y
