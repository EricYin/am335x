# ==========================================
# 1. 目标平台：TI AM335x (OMAP)
# ==========================================
CONFIG_TARGET_omap=y
CONFIG_TARGET_omap_generic=y
CONFIG_TARGET_omap_generic_DEVICE_ti_am335x-c3000a=y

# ==========================================
# 2. OpenWrt 基础系统、LuCI 网页管理与实用工具
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_gpiod-tools=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_vsftpd=y

# ==========================================
# 3. SD 卡与文件系统支持 (EXT4 + FAT32)
# ==========================================
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y

# ==========================================
# 4. USB 主机与常见串口芯片支持
# ==========================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-musb=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# ==========================================
# 5. 双千兆网卡 PHY 驱动与网络工具
# ==========================================
CONFIG_PACKAGE_kmod-phy-broadcom=y
CONFIG_PACKAGE_kmod-phy-marvell=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-phy-atheros=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y

# ==========================================
# 6. 板载蓝牙与音频播放器支持
# ==========================================
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_bluez-alsa=y
CONFIG_PACKAGE_alsa-utils=y
CONFIG_PACKAGE_mpg123=y

# ==========================================
# 7. GPS 定位服务与串口调试工具
# ==========================================
CONFIG_PACKAGE_gpsd=y
CONFIG_PACKAGE_gpsd-clients=y
CONFIG_PACKAGE_picocom=y

# ==========================================
# 8. 硬件加密引擎 (AES/SHA/RNG) 与 OpenSSL 硬件加速
# ==========================================
CONFIG_PACKAGE_kmod-crypto-hw-omap=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_openssl-util=y

# ==========================================
# 9. 双路工业 CAN 总线支持
# ==========================================
CONFIG_PACKAGE_kmod-can=y
CONFIG_PACKAGE_kmod-can-c-can=y
CONFIG_PACKAGE_kmod-can-c-can-platform=y
CONFIG_PACKAGE_canutils=y


#CONFIG_KERNEL_USB_MUSB_HDRC=y          # 冲突：已由 CONFIG_PACKAGE_kmod-usb-musb 管理
