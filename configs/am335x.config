#CONFIG_KERNEL_CRYPTO_DEV_OMAP_AES=y    # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-hw-omap 管理
#CONFIG_KERNEL_CRYPTO_DEV_OMAP_SHAM=y   # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-hw-omap 管理
#CONFIG_KERNEL_HW_RANDOM=y              # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-rng 管理
#CONFIG_KERNEL_HW_RANDOM_OMAP=y         # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-rng 管理
