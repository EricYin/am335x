# ==========================================
# 1. 目标平台：TI AM335x (OMAP)
# ==========================================
CONFIG_TARGET_omap=y
CONFIG_TARGET_omap_generic=y
CONFIG_TARGET_omap_generic_DEVICE_ti_am335x-c3000a=y

CONFIG_LINUX_6_18=y
CONFIG_OMAP_SD_BOOT_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# ==========================================
# 2. OpenWrt 基础系统、LuCI 网页管理与实用工具
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_usbutils=y
CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_busybox=y                  # 精简版工具集，几乎所有命令都靠它
CONFIG_DEFAULT_ca-bundle=y                # 根证书集合（https/wget/curl 等必须）
CONFIG_DEFAULT_logd=y                     # 系统日志守护进程
CONFIG_DEFAULT_procd=y                    # init 系统 / 服务管理核心
CONFIG_DEFAULT_uci=y                      # 配置系统（/etc/config/*）
CONFIG_DEFAULT_urandom-seed=y             # 随机种子保存/恢复（加密相关）
CONFIG_DEFAULT_urngd=y                    # 用户空间 RNG 守护进程
CONFIG_DEFAULT_netifd=y                   # 网络接口管理核心
CONFIG_DEFAULT_mtd=y                      # Flash 操作工具
CONFIG_DEFAULT_fstools=y                  # 文件系统挂载/检查工具
CONFIG_DEFAULT_block-mount=y              # 块设备挂载支持（USB 盘等）
CONFIG_DEFAULT_libc=y
CONFIG_DEFAULT_libgcc=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-ubootenv-nvram=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_gpiod-tools=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y

CONFIG_PACKAGE_dnsmasq=y           
CONFIG_PACKAGE_ip-full=y
CONFIG_IPV6=y                             # 全局 IPv6 支持（不是包，是内核选项）
CONFIG_DEFAULT_odhcp6c=y                  # IPv6 DHCP 客户端
CONFIG_DEFAULT_odhcpd-ipv6only=y          # IPv6-only DHCP 服务器（配合 dnsmasq）
CONFIG_PACKAGE_nftables=y                 # nft 核心工具
CONFIG_PACKAGE_firewall4=y                # nftables 版防火墙（取代旧 firewall）
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y         # nft 硬件转发支持（如果芯片支持）
CONFIG_PACKAGE_ethtool-full=y             # 查看接口速率、双工模式、自动协商状态。

CONFIG_PACKAGE_umdns=y                    # 本地 mDNS/zeroconf 支持（hostname.local 解析）
CONFIG_PACKAGE_kmod-mtd-rw=y              # MTD 分区临时写权限（用于 NAND/eMMC 恢复或刷写）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_fwtool=y

#
# PPPoE
#
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

#
# 包管理器：apk
#
# 添加这一行（默认已由系统启用，但显式指定更保险）：
CONFIG_PACKAGE_apk=y
CONFIG_DEFAULT_apk-tools=y                # apk 主程序包
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_DEFAULT_openwrt-keyring=y          # 签名验证密钥环（apk 生态常用，且官方镜像默认带）

#
# SSH
#
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

# ==========================================
# 3. SD 卡与文件系统支持 (EXT4 + FAT32)
# ==========================================
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_block-mount=y

# ==========================================
# 4. USB 主机与常见串口芯片支持
# ==========================================
CONFIG_USB_SUPPORT=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-usb-musb=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# ==========================================
# 5. 双千兆网卡 PHY 驱动与网络工具
# ==========================================
CONFIG_PACKAGE_kmod-phy-broadcom=y
CONFIG_PACKAGE_kmod-phy-marvell=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-phy-atheros=y

# ==========================================
# 6. 板载蓝牙与音频播放器支持
# ==========================================
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_bluez-alsa=y
CONFIG_PACKAGE_audio-support=y
CONFIG_PACKAGE_input-support=y
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_alsa-utils=y
CONFIG_PACKAGE_mpg123=y
# CONFIG_PACKAGE_mpd-mini is not set

# ==========================================
# 7. GPS 定位服务与串口调试工具
# ==========================================
CONFIG_PACKAGE_gpsd=y
CONFIG_PACKAGE_gpsd-clients=y
CONFIG_PACKAGE_picocom=y

# ==========================================
# 8. 硬件加密引擎 (AES/SHA/RNG) 与 OpenSSL 硬件加速
# ==========================================
CONFIG_PACKAGE_kmod-crypto-hw-omap=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_openssl-util=y

# ==========================================
# 9. 双路工业 CAN 总线支持
# ==========================================
CONFIG_PACKAGE_kmod-can=y
CONFIG_PACKAGE_kmod-can-c-can=y
CONFIG_PACKAGE_kmod-can-c-can-platform=y
CONFIG_PACKAGE_canutils=y

CONFIG_PACKAGE_vsftpd=y

#CONFIG_KERNEL_USB_MUSB_HDRC=y          # 冲突：已由 CONFIG_PACKAGE_kmod-usb-musb 管理
#CONFIG_KERNEL_USB_MUSB_DSPS=y          # 冲突：已由 CONFIG_PACKAGE_kmod-usb-musb 管理
#CONFIG_KERNEL_USB_TI_CPPI41_DMA=y      # 冲突：已由 CONFIG_PACKAGE_kmod-usb-musb 管理
#CONFIG_KERNEL_CRYPTO_HW=y              # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-hw-omap 管理
#CONFIG_KERNEL_CRYPTO_DEV_OMAP=y        # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-hw-omap 管理
#CONFIG_KERNEL_CRYPTO_DEV_OMAP_AES=y    # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-hw-omap 管理
#CONFIG_KERNEL_CRYPTO_DEV_OMAP_SHAM=y   # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-hw-omap 管理
#CONFIG_KERNEL_HW_RANDOM=y              # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-rng 管理
#CONFIG_KERNEL_HW_RANDOM_OMAP=y         # 冲突：已由 CONFIG_PACKAGE_kmod-crypto-rng 管理
#CONFIG_KERNEL_AT803X_PHY=y             # 冲突：已由 CONFIG_PACKAGE_kmod-phy-atheros 管理

#CONFIG_PACKAGE_libgpiod-tools=y        # 过时包名：已更名为 CONFIG_PACKAGE_gpiod-tools=y（已在第二部分保留）
#CONFIG_PACKAGE_kmod-phy-at803x=y       # 重复/冗余包：AT803x PHY 驱动在 6.x 内核中已并入 CONFIG_PACKAGE_kmod-phy-atheros=y
