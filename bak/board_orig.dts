			serial-dir = <0x01 0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			tx-num-evt = <0x20>;
			rx-num-evt = <0x20>;
			linux,phandle = <0x5a>;
			phandle = <0x5a>;
		};

		mcasp@4803C000 {
			compatible = "ti,am33xx-mcasp-audio";
			ti,hwmods = "mcasp1";
			reg = <0x4803c000 0x2000 0x46400000 0x400000>;
			reg-names = "mpu", "dat";
			interrupts = <0x52 0x53>;
			interrupts-names = "tx", "rx";
			status = "disabled";
			dmas = <0x24 0x0a 0x24 0x0b>;
			dma-names = "tx", "rx";
		};

		rng@48310000 {
			compatible = "ti,omap4-rng";
			ti,hwmods = "rng";
			reg = <0x48310000 0x2000>;
			interrupts = <0x6f>;
		};

		sgx@0x56000000 {
			compatible = "ti,sgx";
			ti,hwmods = "gfx";
			reg = <0x56000000 0x1000000>;
			interrupts = <0x25>;
		};
	};

	buzzer {
		compatible = "ti,am335x-buzzer";
		gpios = <0x52 0x1c 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x53>;
		status = "okay";
	};

	gprs {
		compatible = "ti,am335x-gprs";
		gpios = <0x54 0x12 0x00 0x54 0x04 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x55>;
		status = "okay";
	};

	lcd {
		compatible = "ti,am335x-lcd";
		gpios = <0x34 0x0d 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x56>;
		status = "okay";
	};

	led {
		compatible = "ti,am335x-led";
		gpios = <0x52 0x1e 0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x57>;
		status = "okay";
	};

	fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "vbat";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-boot-on;
		linux,phandle = <0x2f>;
		phandle = <0x2f>;
	};

	fixedregulator@1 {
		compatible = "regulator-fixed";
		regulator-name = "lis3_reg";
		regulator-boot-on;
	};

	volume_keys@0 {
		compatible = "gpio-keys";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		autorepeat;

		switch@9 {
			label = "volume-up";
			linux,code = <0x73>;
			gpios = <0x54 0x02 0x01>;
			gpio-key,wakeup;
		};

		switch@10 {
			label = "volume-down";
			linux,code = <0x72>;
			gpios = <0x54 0x03 0x01>;
			gpio-key,wakeup;
		};
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0x58 0x00 0xc350 0x00>;
		brightness-levels = <0x00 0x20 0x40 0x60 0x80 0x9f 0xbf 0xdf 0xff>;
		default-brightness-level = <0x08>;
		gpios = <0x34 0x11 0x00>;
	};

	panel {
		compatible = "ti,tilcdc,panel";
		status = "okay";

		panel-info {
			ac-bias = <0xff>;
			ac-bias-intrpt = <0x00>;
			dma-burst-sz = <0x10>;
			bpp = <0x20>;
			fdd = <0x80>;
			sync-edge = <0x00>;
			sync-ctrl = <0x01>;
			raster-order = <0x00>;
			fifo-th = <0x00>;
		};

		display-timings {

			800x480p62 {
				clock-frequency = <0x1c9c380>;
				hactive = <0x320>;
				vactive = <0x1e0>;
				hfront-porch = <0x27>;
				hback-porch = <0x27>;
				hsync-len = <0x2f>;
				vback-porch = <0x1d>;
				vfront-porch = <0x0d>;
				vsync-len = <0x02>;
				hsync-active = <0x01>;
				vsync-active = <0x01>;
			};
		};
	};

	kim {
		compatible = "kim";
		nshutdown_gpio = <0x75>;
		dev_name = "/dev/ttyO1";
		flow_cntrl = <0x01>;
		baud_rate = <0x2dc6c0>;
	};

	btwilink {
		compatible = "btwilink";
	};

	sound {
		compatible = "ti,da830-evm-audio";
		ti,model = "AM335x-EVM";
		ti,audio-codec = <0x59>;
		ti,mcasp-controller = <0x5a>;
		ti,codec-clock-rate = <0x16e3600>;
		ti,audio-routing = "Headphone Jack", "HPLOUT", "Headphone Jack", "HPROUT", "Line Out", "LLOUT", "Line Out", "RLOUT", "MIC3L", "Mic Bias 2V", "MIC3R", "Mic Bias 2V", "Mic Bias 2V", "Mic Jack", "LINE1L", "Line In", "LINE2L", "Line In", "LINE1R", "Line In", "LINE2R", "Line In";
	};
};
