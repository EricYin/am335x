/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	compatible = "ti,am335x-evm", "ti,am33xx";
	interrupt-parent = <0x01>;
	model = "TI AM335x EVM";

	chosen {
	};

	aliases {
		i2c1 = "/ocp/i2c@44e0b000";
		i2c0 = "/ocp/i2c@4802a000";
		i2c2 = "/ocp/i2c@4819c000";
		serial0 = "/ocp/serial@44e09000";
		serial1 = "/ocp/serial@48022000";
		serial2 = "/ocp/serial@48024000";
		serial3 = "/ocp/serial@481a6000";
		serial4 = "/ocp/serial@481a8000";
		serial5 = "/ocp/serial@481aa000";
		d_can0 = "/ocp/can@481cc000";
		d_can1 = "/ocp/can@481d0000";
		usb0 = "/ocp/usb@47400000/usb@47401000";
		usb1 = "/ocp/usb@47400000/usb@47401800";
		phy0 = "/ocp/usb@47400000/usb-phy@47401300";
		phy1 = "/ocp/usb@47400000/usb-phy@47401b00";
		ethernet0 = "/ocp/ethernet@4a100000/slave@4a100200";
		ethernet1 = "/ocp/ethernet@4a100000/slave@4a100300";
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a8";
			device_type = "cpu";
			reg = <0x00>;
			voltage-tolerance = <0x02>;
			clocks = <0x02>;
			clock-names = "cpu";
			clock-latency = <0x493e0>;
			cpu0-supply = <0x03>;
		};
	};

	pmu {
		compatible = "arm,cortex-a8-pmu";
		interrupts = <0x03>;
	};

	soc {
		compatible = "ti,omap-infra";

		mpu {
			compatible = "ti,omap3-mpu";
			ti,hwmods = "mpu";
		};
	};

	control_module@4a002000 {
		compatible = "syscon";
		reg = <0x44e10000 0x7fc>;
		linux,phandle = <0x36>;
		phandle = <0x36>;
	};

	pinmux@44e10800 {
		compatible = "pinctrl-single";
		reg = <0x44e10800 0x238>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-single,register-width = <0x20>;
		pinctrl-single,function-mask = <0x7f>;

		pinmux_buzzer_gpio_default {
			pinctrl-single,pins = <0x78 0x17>;
			linux,phandle = <0x53>;
			phandle = <0x53>;
		};

		pinmux_gprs_gpio_default {
			pinctrl-single,pins = <0x21c 0x17 0x158 0x07>;
			linux,phandle = <0x55>;
			phandle = <0x55>;
		};

		pinmux_lcd_gpio_default {
			pinctrl-single,pins = <0x234 0x07>;
			linux,phandle = <0x56>;
			phandle = <0x56>;
		};

		pinmux_led_gpio_default {
			pinctrl-single,pins = <0x80 0x07>;
			linux,phandle = <0x57>;
			phandle = <0x57>;
		};

		pinmux_i2c0_pins {
			pinctrl-single,pins = <0x188 0x30 0x18c 0x30>;
			linux,phandle = <0x2e>;
			phandle = <0x2e>;
		};

		pinmux_usb_pins {
			pinctrl-single,pins;
		};

		pinmux_uart0_pins {
			pinctrl-single,pins = <0x170 0x30 0x174 0x00>;
			linux,phandle = <0x25>;
			phandle = <0x25>;
		};

		pinmux_uart2_pins_default {
			pinctrl-single,pins = <0x10c 0x36 0x110 0x06>;
			linux,phandle = <0x26>;
			phandle = <0x26>;
		};

		pinmux_uart2_pins_sleep {
			pinctrl-single,pins = <0x10c 0x27 0x110 0x27>;
			linux,phandle = <0x27>;
			phandle = <0x27>;
		};

		pinmux_uart3_pins_default {
			pinctrl-single,pins = <0x160 0x31 0x164 0x01>;
			linux,phandle = <0x28>;
			phandle = <0x28>;
		};

		pinmux_uart3_pins_sleep {
			pinctrl-single,pins = <0x160 0x27 0x164 0x27>;
			linux,phandle = <0x29>;
			phandle = <0x29>;
		};

		pinmux_uart4_pins_default {
			pinctrl-single,pins = <0x168 0x31 0x16c 0x01>;
			linux,phandle = <0x2a>;
			phandle = <0x2a>;
		};

		pinmux_uart4_pins_sleep {
			pinctrl-single,pins = <0x168 0x27 0x16c 0x27>;
			linux,phandle = <0x2b>;
			phandle = <0x2b>;
		};

		pinmux_uart5_pins_default {
			pinctrl-single,pins = <0x108 0x33 0x144 0x03>;
			linux,phandle = <0x2c>;
			phandle = <0x2c>;
		};

		pinmux_uart5_pins_sleep {
			pinctrl-single,pins = <0x108 0x27 0x144 0x27>;
			linux,phandle = <0x2d>;
			phandle = <0x2d>;
		};

		nandflash_pins_default {
			pinctrl-single,pins = <0x00 0x30 0x04 0x30 0x08 0x30 0x0c 0x30 0x10 0x30 0x14 0x30 0x18 0x30 0x1c 0x30 0x70 0x30 0x74 0x37 0x7c 0x08 0x90 0x08 0x94 0x08 0x98 0x08 0x9c 0x08>;
			linux,phandle = <0x4d>;
			phandle = <0x4d>;
		};

		nandflash_pins_sleep {
			pinctrl-single,pins = <0x00 0x27 0x04 0x27 0x08 0x27 0x0c 0x27 0x10 0x27 0x14 0x27 0x18 0x27 0x1c 0x27 0x70 0x27 0x74 0x27 0x7c 0x27 0x90 0x27 0x94 0x27 0x98 0x27 0x9c 0x27>;
			linux,phandle = <0x4e>;
			phandle = <0x4e>;
		};

		backlight_pins {
			pinctrl-single,pins = <0x19c 0x04>;
			linux,phandle = <0x3e>;
			phandle = <0x3e>;
		};

		ecap2_pins_sleep {
			pinctrl-single,pins = <0x19c 0x17>;
			linux,phandle = <0x3f>;
			phandle = <0x3f>;
		};

		cpsw_default {
			pinctrl-single,pins = <0x114 0x02 0x118 0x22 0x11c 0x02 0x120 0x02 0x124 0x02 0x128 0x02 0x12c 0x02 0x130 0x22 0x134 0x22 0x138 0x22 0x13c 0x22 0x140 0x22 0x40 0x02 0x44 0x22 0x48 0x02 0x4c 0x02 0x50 0x02 0x54 0x02 0x58 0x02 0x5c 0x22 0x60 0x22 0x64 0x22 0x68 0x22 0x6c 0x22>;
			linux,phandle = <0x42>;
			phandle = <0x42>;
		};

		cpsw_sleep {
			pinctrl-single,pins = <0x114 0x27 0x118 0x27 0x11c 0x27 0x120 0x27 0x124 0x27 0x128 0x27 0x12c 0x27 0x130 0x27 0x134 0x27 0x138 0x27 0x13c 0x27 0x140 0x27 0x40 0x27 0x44 0x27 0x48 0x27 0x4c 0x27 0x50 0x27 0x54 0x27 0x58 0x27 0x5c 0x27 0x60 0x27 0x64 0x27 0x68 0x27 0x6c 0x27>;
			linux,phandle = <0x43>;
			phandle = <0x43>;
		};

		davinci_mdio_default {
			pinctrl-single,pins = <0x148 0x70 0x14c 0x10>;
			linux,phandle = <0x44>;
			phandle = <0x44>;
		};

		davinci_mdio_sleep {
			pinctrl-single,pins = <0x148 0x27 0x14c 0x27>;
			linux,phandle = <0x45>;
			phandle = <0x45>;
		};

		pinmux_mmc1_pins {
			pinctrl-single,pins = <0xf0 0x30 0xf4 0x30 0xf8 0x30 0xfc 0x30 0x100 0x30 0x104 0x30 0x1e8 0x2f>;
			linux,phandle = <0x32>;
			phandle = <0x32>;
		};

		pinmux_mmc1_pins_sleep {
			pinctrl-single,pins = <0xf0 0x27 0xf4 0x27 0xf8 0x27 0xfc 0x27 0x100 0x27 0x104 0x27>;
			linux,phandle = <0x33>;
			phandle = <0x33>;
		};

		lcd_pins_default {
			pinctrl-single,pins = <0x20 0x01 0x24 0x01 0x28 0x01 0x2c 0x01 0x30 0x01 0x34 0x01 0x38 0x01 0x3c 0x01 0xa0 0x00 0xa4 0x00 0xa8 0x00 0xac 0x00 0xb0 0x00 0xb4 0x00 0xb8 0x00 0xbc 0x00 0xc0 0x00 0xc4 0x00 0xc8 0x00 0xcc 0x00 0xd0 0x00 0xd4 0x00 0xd8 0x00 0xdc 0x00 0xe0 0x00 0xe4 0x00 0xe8 0x00 0xec 0x00>;
			linux,phandle = <0x4b>;
			phandle = <0x4b>;
		};

		lcd_pins_sleep {
			pinctrl-single,pins = <0x20 0x27 0x24 0x27 0x28 0x27 0x2c 0x27 0x30 0x27 0x34 0x27 0x38 0x27 0x3c 0x27 0xa0 0x0f 0xa4 0x0f 0xa8 0x0f 0xac 0x0f 0xb0 0x0f 0xb4 0x0f 0xb8 0x0f 0xbc 0x0f 0xc0 0x0f 0xc4 0x0f 0xc8 0x0f 0xcc 0x0f 0xd0 0x0f 0xd4 0x0f 0xd8 0x0f 0xdc 0x0f 0xe0 0x27 0xe4 0x27 0xe8 0x27 0xec 0x27>;
			linux,phandle = <0x4c>;
			phandle = <0x4c>;
		};

		am335x_evm_audio_pins {
			pinctrl-single,pins = <0x190 0x20 0x194 0x20 0x198 0x20 0x1a8 0x20 0x1ac 0x08>;
			linux,phandle = <0x50>;
			phandle = <0x50>;
		};

		am335x_evm_audio_pins_sleep {
			pinctrl-single,pins = <0x190 0x27 0x194 0x27 0x198 0x27 0x1a8 0x27 0x1ac 0x27>;
			linux,phandle = <0x51>;
			phandle = <0x51>;
		};

		dcan0_pins_default {
			pinctrl-single,pins = <0x178 0x0a 0x17c 0x22>;
			linux,phandle = <0x37>;
			phandle = <0x37>;
		};

		dcan1_pins_default {
			pinctrl-single,pins = <0x180 0x0a 0x184 0x22>;
			linux,phandle = <0x39>;
			phandle = <0x39>;
		};
	};

	ocp {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		ti,hwmods = "l3_main";

		prcm@44e00000 {
			compatible = "ti,am3-prcm";
			reg = <0x44e00000 0x4000>;

			clocks {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				clk_32768_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0x8000>;
					linux,phandle = <0x14>;
					phandle = <0x14>;
				};

				clk_rc32k_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0x7d00>;
					linux,phandle = <0x13>;
					phandle = <0x13>;
				};

				virt_19200000_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0x124f800>;
					linux,phandle = <0x20>;
					phandle = <0x20>;
				};

				virt_24000000_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0x16e3600>;
					linux,phandle = <0x21>;
					phandle = <0x21>;
				};

				virt_25000000_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0x17d7840>;
					linux,phandle = <0x22>;
					phandle = <0x22>;
				};

				virt_26000000_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0x18cba80>;
					linux,phandle = <0x23>;
					phandle = <0x23>;
				};

				tclkin_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-clock";
					clock-frequency = <0xb71b00>;
					linux,phandle = <0x12>;
					phandle = <0x12>;
				};

				dpll_core_ck {
					#clock-cells = <0x00>;
					compatible = "ti,am3-dpll-core-clock";
					clocks = <0x04 0x04>;
					reg = <0x490 0x45c 0x468>;
					linux,phandle = <0x05>;
					phandle = <0x05>;
				};

				dpll_core_x2_ck {
					#clock-cells = <0x00>;
					compatible = "ti,am3-dpll-x2-clock";
					clocks = <0x05>;
					linux,phandle = <0x06>;
					phandle = <0x06>;
				};

				dpll_core_m4_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x06>;
					ti,max-div = <0x1f>;
					reg = <0x480>;
					ti,index-starts-at-one;
					linux,phandle = <0x0e>;
					phandle = <0x0e>;
				};

				dpll_core_m5_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x06>;
					ti,max-div = <0x1f>;
					reg = <0x484>;
					ti,index-starts-at-one;
					linux,phandle = <0x16>;
					phandle = <0x16>;
				};

				dpll_core_m6_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x06>;
					ti,max-div = <0x1f>;
					reg = <0x4d8>;
					ti,index-starts-at-one;
				};

				dpll_mpu_ck {
					#clock-cells = <0x00>;
					compatible = "ti,am3-dpll-clock";
					clocks = <0x04 0x04>;
					reg = <0x488 0x420 0x42c>;
					linux,phandle = <0x02>;
					phandle = <0x02>;
				};

				dpll_mpu_m2_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x02>;
					ti,max-div = <0x1f>;
					reg = <0x4a8>;
					ti,index-starts-at-one;
				};

				dpll_ddr_ck {
					#clock-cells = <0x00>;
					compatible = "ti,am3-dpll-no-gate-clock";
					clocks = <0x04 0x04>;
					reg = <0x494 0x434 0x440>;
					linux,phandle = <0x07>;
					phandle = <0x07>;
				};

				dpll_ddr_m2_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x07>;
					ti,max-div = <0x1f>;
					reg = <0x4a0>;
					ti,index-starts-at-one;
					linux,phandle = <0x08>;
					phandle = <0x08>;
				};

				dpll_ddr_m2_div2_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x08>;
					clock-mult = <0x01>;
					clock-div = <0x02>;
				};

				dpll_disp_ck {
					#clock-cells = <0x00>;
					compatible = "ti,am3-dpll-no-gate-clock";
					clocks = <0x04 0x04>;
					reg = <0x498 0x448 0x454>;
					linux,phandle = <0x09>;
					phandle = <0x09>;
				};

				dpll_disp_m2_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x09>;
					ti,max-div = <0x1f>;
					reg = <0x4a4>;
					ti,index-starts-at-one;
					ti,set-rate-parent;
					linux,phandle = <0x10>;
					phandle = <0x10>;
				};

				dpll_per_ck {
					#clock-cells = <0x00>;
					compatible = "ti,am3-dpll-no-gate-j-type-clock";
					clocks = <0x04 0x04>;
					reg = <0x48c 0x470 0x49c>;
					linux,phandle = <0x0a>;
					phandle = <0x0a>;
				};

				dpll_per_m2_ck {
					#clock-cells = <0x00>;
					compatible = "ti,divider-clock";
					clocks = <0x0a>;
					ti,max-div = <0x1f>;
					reg = <0x4ac>;
					ti,index-starts-at-one;
					linux,phandle = <0x0b>;
					phandle = <0x0b>;
				};

				dpll_per_m2_div4_wkupdm_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0b>;
					clock-mult = <0x01>;
					clock-div = <0x04>;
				};

				dpll_per_m2_div4_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0b>;
					clock-mult = <0x01>;
					clock-div = <0x04>;
				};

				cefuse_fck {
					#clock-cells = <0x00>;
					compatible = "ti,gate-clock";
					clocks = <0x04>;
					ti,bit-shift = <0x01>;
					reg = <0xa20>;
				};

				clk_24mhz {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0b>;
					clock-mult = <0x01>;
					clock-div = <0x08>;
					linux,phandle = <0x0c>;
					phandle = <0x0c>;
				};

				clkdiv32k_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0c>;
					clock-mult = <0x01>;
					clock-div = <0x2dc>;
					linux,phandle = <0x0d>;
					phandle = <0x0d>;
				};

				clkdiv32k_ick {
					#clock-cells = <0x00>;
					compatible = "ti,gate-clock";
					clocks = <0x0d>;
					ti,bit-shift = <0x01>;
					reg = <0x14c>;
					linux,phandle = <0x11>;
					phandle = <0x11>;
				};

				l3_gclk {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0e>;
					clock-mult = <0x01>;
					clock-div = <0x01>;
					linux,phandle = <0x0f>;
					phandle = <0x0f>;
				};

				pruss_ocp_gclk {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x0f 0x10>;
					reg = <0x530>;
				};

				mmu_fck {
					#clock-cells = <0x00>;
					compatible = "ti,gate-clock";
					clocks = <0x0e>;
					ti,bit-shift = <0x01>;
					reg = <0x914>;
				};

				timer1_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x04 0x11 0x12 0x13 0x14>;
					reg = <0x528>;
				};

				timer2_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x12 0x04 0x11>;
					reg = <0x508>;
				};

				timer3_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x12 0x04 0x11>;
					reg = <0x50c>;
				};

				timer4_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x12 0x04 0x11>;
					reg = <0x510>;
				};

				timer5_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x12 0x04 0x11>;
					reg = <0x518>;
				};

				timer6_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x12 0x04 0x11>;
					reg = <0x51c>;
				};

				timer7_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x12 0x04 0x11>;
					reg = <0x504>;
				};

				usbotg_fck {
					#clock-cells = <0x00>;
					compatible = "ti,gate-clock";
					clocks = <0x0a>;
					ti,bit-shift = <0x08>;
					reg = <0x47c>;
				};

				dpll_core_m4_div2_ck {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0e>;
					clock-mult = <0x01>;
					clock-div = <0x02>;
					linux,phandle = <0x15>;
					phandle = <0x15>;
				};

				ieee5000_fck {
					#clock-cells = <0x00>;
					compatible = "ti,gate-clock";
					clocks = <0x15>;
					ti,bit-shift = <0x01>;
					reg = <0xe4>;
				};

				wdt1_fck {
					#clock-cells = <0x00>;
					compatible = "ti,mux-clock";
					clocks = <0x13 0x11>;
					reg = <0x538>;
				};

				l4_rtc_gclk {
					#clock-cells = <0x00>;
					compatible = "fixed-factor-clock";
					clocks = <0x0e>;
					clock-mult = <0x01>;
					clock-div = <0x02>;
				};

