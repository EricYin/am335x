#!/bin/sh

# 1. 清理所有旧的设备（网桥）配置，彻底移除 br-lan
while uci -q delete network.@device[0]; do :; done
uci -q delete network.lan_dev

# 2. 配置 LAN 口：直接绑定物理网口 eth0，静态 IP 为 192.168.1.1
uci set network.lan=interface
uci set network.lan.device='eth0'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'

# 3. 配置 WAN 口：直接绑定物理网口 eth1，默认 DHCP 自动获取上游 IP
uci set network.wan=interface
uci set network.wan.device='eth1'
uci set network.wan.proto='dhcp'

# 如需关闭 IPv6 WAN，可保留下一行；如需使用 IPv6 可将其改为 dhcpv6
uci -q delete network.wan6

# 4. 开启 LAN 口 DHCP 服务，电脑连接 eth0 自动获取 192.168.1.x
uci set dhcp.lan=dhcp
uci set dhcp.lan.interface='lan'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.ignore

# 5. 确保 WAN 口关闭 DHCP 服务端，避免干扰上级网络
uci set dhcp.wan=dhcp
uci set dhcp.wan.interface='wan'
uci set dhcp.wan.ignore='1'

uci commit network
uci commit dhcp

# 6. 重启网络和 DHCP 服务使配置立即生效（如果作为首次启动脚本可保留）
/etc/init.d/network restart
/etc/init.d/dnsmasq restart

exit 0
