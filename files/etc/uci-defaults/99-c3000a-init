#!/bin/sh

# 1. 清理旧的设备（网桥）及接口配置，彻底移除 br-lan 避免残留参数冲突
while uci -q delete network.@device[0]; do :; done
uci -q delete network.lan_dev
uci -q delete network.lan
uci -q delete network.wan
uci -q delete network.wan6

# 2. 配置 LAN 口：直接绑定物理网口 eth0，静态 IP 为 192.168.1.1
uci set network.lan=interface
uci set network.lan.device='eth0'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.50.230'
uci set network.lan.netmask='255.255.255.0'

# 3. 配置 WAN 口：直接绑定物理网口 eth1，默认 DHCP 自动获取上游 IP
uci set network.wan=interface
uci set network.wan.device='eth1'
uci set network.wan.proto='dhcp'

# （可选）如需恢复 WAN6 IPv6 获取，取消下面三行注释
# uci set network.wan6=interface
# uci set network.wan6.device='eth1'
# uci set network.wan6.proto='dhcpv6'

# 4. 开启 LAN 口 DHCP 服务，电脑连接 eth0 自动获取 192.168.1.x
# uci set dhcp.lan=dhcp
# uci set dhcp.lan.interface='lan'
# uci set dhcp.lan.start='100'
# uci set dhcp.lan.limit='150'
# uci set dhcp.lan.leasetime='12h'
# uci -q delete dhcp.lan.ignore

# 5. 确保 WAN 口关闭 DHCP 服务端，避免干扰上级网络
uci set dhcp.wan=dhcp
uci set dhcp.wan.interface='wan'
uci set dhcp.wan.ignore='1'

# 提交配置生效
uci commit network
uci commit dhcp

# 1. 创建音乐目录与 MPD 运行目录
mkdir -p /home/u1/share/music
chmod 777 /home/u1/share

mkdir -p /home/u1/.mpd/playlists
chmod -R 755 /home/u1/.mpd
chown -R mpd:mpd /home/u1/.mpd

# 2. 确保 mpd 用户拥有访问声卡设备 (/dev/snd/*) 的权限
grep -q "^pulse:.*mpd" /etc/group || sed -i 's/^\(pulse:[^:]*:[^:]*:[^:]*\)$/\1,mpd/' /etc/group
sed -i 's/:,/:/g' /etc/group

# 3. 备份并生成 /etc/mpd.conf（使用 ALSA 直出并禁用有缺陷的 faad 解码器）
[ -e /etc/mpd.conf ] && [ ! -e /etc/mpd.conf.bak ] && mv /etc/mpd.conf /etc/mpd.conf.bak

cat << 'EOF' > /etc/mpd.conf
music_directory     "/home/u1/share/music"
playlist_directory  "/home/u1/.mpd/playlists"
db_file             "/home/u1/.mpd/mpd.db"
log_file            "/home/u1/.mpd/mpd.log"
pid_file            "/home/u1/.mpd/mpd.pid"
state_file          "/home/u1/.mpd/mpdstate"

user                "mpd"
bind_to_address     "0.0.0.0"
port                "6600"

audio_output {
    type            "alsa"
    name            "AM335x Sound Card"
    device          "plughw:0,0"
    mixer_type      "software"
}

decoder {
    plugin          "faad"
    enabled         "no"
}
EOF

# 4. 如果直接走 ALSA 输出，停掉后台占用的 PulseAudio（防止 Device busy）
[ -x /etc/init.d/pulseaudio ] && {
    /etc/init.d/pulseaudio stop
    /etc/init.d/pulseaudio disable
}

# 5. 设置安全适中的 ALSA 硬件音量增益（防止开机默认静音或过响）
amixer sset 'PCM' 75% >/dev/null 2>&1
amixer sset 'HP DAC' 75% >/dev/null 2>&1
amixer sset 'Line DAC' 75% >/dev/null 2>&1
amixer sset 'HP' 2 >/dev/null 2>&1
amixer sset 'Line' 2 >/dev/null 2>&1
#alsactl store

# 6. 重启 MPD 服务使配置生效
/etc/init.d/mpd enable
/etc/init.d/mpd restart

exit 0
